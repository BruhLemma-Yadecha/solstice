# Django Core Settings
SECRET_KEY='my_django_secret_key'
DEBUG=True
ALLOWED_HOSTS='localhost,127.0.0.1,your_domain.com'

# --- Port Configuration for Docker Compose ---
# These variables control the port mappings in docker-compose.yml.
# The _CONTAINER_PORT is the port the service listens on *inside* its container.
# The _HOST_PORT_FORWARD is the port on your host machine that forwards to the container's port.

# Web Application (Gunicorn)
WEB_APP_CONTAINER_PORT=8000
WEB_APP_HOST_PORT_FORWARD=8000

# PostgreSQL Database
POSTGRES_CONTAINER_PORT=5432
POSTGRES_HOST_PORT_FORWARD=5432

# Redis
REDIS_CONTAINER_PORT=6379
REDIS_HOST_PORT_FORWARD=6379

# --- Service Specific Settings ---

# PostgreSQL Database (Initialization & Django Connection)
# Variables used by the 'db' service in docker-compose.yml to initialize.
POSTGRES_DB=solstice_db
POSTGRES_USER=solstice_user
POSTGRES_PASSWORD='your_secure_password_here'

# Variables used by Django (settings.py) to connect to the database.
DB_ENGINE='django.db.backends.postgresql'
DB_NAME=${POSTGRES_DB}
DB_USER=${POSTGRES_USER}
DB_PASSWORD=${POSTGRES_PASSWORD}
DB_HOST=db # Service name for internal Docker communication
DB_PORT=${POSTGRES_CONTAINER_PORT} # Django connects to the port *inside* the 'db' container

# Redis (Celery/Django Connection)
# Variables used by Django/Celery (settings.py) to connect to Redis.
REDIS_HOST=redis # Service name for internal Docker communication
REDIS_PORT=${REDIS_CONTAINER_PORT} # Django/Celery connects to the port *inside* the 'redis' container
CELERY_BROKER_REDIS_DB_NUMBER=0
CELERY_RESULTS_REDIS_DB_NUMBER=1

